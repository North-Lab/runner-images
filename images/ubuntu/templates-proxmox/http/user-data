#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu2604
    username: packer
    # Hash of the build-time password "packer" (salt u2604pkr). Change both this
    # hash and ssh_password together if you do not want the default.
    password: "$6$u2604pkr$B4vF/zuSjHeZc.QjiZJf/CXQ1XsnMIrFquepjrN1uaHq449SoEd9BW0iw9otSC2/hRq1za8.NTPo0NUhiM0tY1"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: lvm
  packages:
    - qemu-guest-agent
    - cloud-init
    - sudo
    - openssh-server
  user-data:
    disable_root: false
    package_upgrade: false
    users:
      - name: packer
        groups: [adm, sudo]
        lock_passwd: false
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
        passwd: "$6$u2604pkr$B4vF/zuSjHeZc.QjiZJf/CXQ1XsnMIrFquepjrN1uaHq449SoEd9BW0iw9otSC2/hRq1za8.NTPo0NUhiM0tY1"
  late-commands:
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/packer
    - chmod 440 /target/etc/sudoers.d/packer
    - curtin in-target --target=/target -- systemctl enable qemu-guest-agent
    # Do not `systemctl enable cloud-init`. Ubuntu 26 / cloud-init 25+ no longer
    # ships cloud-init.service; that command exits 1 and aborts Subiquity.
    # The cloud-init package (listed above) plus the systemd generator enable
    # cloud-init.target and the real units (cloud-init-main.service,
    # cloud-init-local.service, cloud-init-network.service, cloud-config.service,
    # cloud-final.service). deprovision-proxmox.sh re-enables any of those that
    # exist and declare [Install] before the VM is converted to a template.
